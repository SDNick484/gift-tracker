# Household defaults baked into dist/setup-tracker.sh by installer/build.sh.
# Copy to deploy/deploy.env (git-ignored) and fill in your own values.
# They only matter on a FIRST install; after that /etc/conf.d/tracker on the container is the source of truth.
# Values may not contain a double quote, backtick, dollar sign or backslash.

# The two owners' emails: the only addresses admitted.
ALLOWED_EMAILS=alex@example.com,sam@example.com

# Display names for them.
USERS=alex@example.com=Alex,sam@example.com=Sam

# Cloudflare Zero Trust > Settings > team domain, and the AUD tag of the tracker's own Access application.
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_AUD=

# Page title and home-screen name. Keep it neutral.
APP_NAME=Ledger

# family (the default) or school. Leave it unset for the family build. A school instance is installed from a build
# whose env file sets MODE=school: copy this file to deploy/school.env (git-ignored) and run
#   DEPLOY_ENV=deploy/school.env sh installer/build.sh
# MODE=family
