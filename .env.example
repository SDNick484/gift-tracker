# Development settings for `python app.py`; see the top of settings.py. Copy to .env and export it yourself
# (nothing loads this file). On the server the installer writes /etc/conf.d/tracker instead.
TRACKER_PORT=8767
ALLOWED_EMAILS=alex@example.com,sam@example.com
USERS=alex@example.com=Alex,sam@example.com=Sam
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_AUD=
APP_NAME=Ledger
LOCK_IDLE_SECONDS=300
MODE=family

# Not read by the app: the MCP service's settings (mcp_server.py, mcp_http.py; docs/mcp-setup.md). On the server the
# installer writes them to /etc/conf.d/tracker-mcp.
# TRACKER_URL=http://127.0.0.1:8767
# TRACKER_API_TOKEN=gt_...   (Settings > Agent tokens)
# MCP_HTTP_BIND=127.0.0.1
# MCP_HTTP_PORT=8779
# MCP_HTTP_PATH=/tracker/mcp
# MCP_PUBLIC_HOSTS=mcp.example.com
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# MCP_ALLOWED_EMAILS=alex@example.com,sam@example.com
